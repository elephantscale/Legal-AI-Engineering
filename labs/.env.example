# Legal AI Engineering — lab environment.
# Copy to .env and source it, or export these directly. Nothing here is a secret:
# the whole point of the course is that the defaults keep your data on the machine.
#
#     cp .env.example .env && set -a && . ./.env && set +a

# ---------------------------------------------------------------------------- mode
# local    (default) an OpenAI-compatible endpoint on this machine — Ollama or vLLM
# offline  no model at all: deterministic stdlib fallbacks. Every lab still completes.
# cloud    the CONTRAST CASE ONLY. Used in Lab 04 to show what it costs you legally.
#          Never the happy path, and never with real case data.
LEGAL_AI_MODE=local

# ------------------------------------------------------------------- local serving
LEGAL_AI_BASE_URL=http://localhost:11434/v1
LEGAL_AI_MODEL=qwen3:8b
# qwen3:14b is the recommended tier if you have 24 GB of VRAM; see Module 5's table.
LEGAL_AI_EMBED=nomic-embed-text
# Changing the embedding model changes the VECTOR DIMENSION and forces a full re-ingest.
# nomic-embed-text is 768; mxbai-embed-large is 1024. You cannot mix them in one store.

# ------------------------------------------------------------------------- egress
# deny      loopback only. Everything else raises and is logged. (the default)
# deny-lan  loopback + RFC1918 — for a compose deployment where the model is a service
# observe   record, block nothing. Step one on a system you did not build. NOT for a
#           real matter: it is a legal auto-fail in Module 7's overlay.
LEGAL_AI_EGRESS=deny

# -------------------------------------------------------------------------- optional
# Apache Tika, if you want the real 1,400-format extraction path (Lab 01).
# TIKA_URL=http://localhost:9998

# Lab 10's per-unit CPU cost — a labelled stand-in for extraction + OCR, so the
# throughput curve measures your hardware rather than process startup. 0 to disable.
# LAB10_WORK_ROUNDS=1500

# ---------------------------------------------------------------------------- cloud
# Only needed for Lab 04's `compare` command, which deliberately shows you what a cloud
# call discloses. Leave it unset and the comparison reports the local side only.
# LEGAL_AI_API_KEY=
